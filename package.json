{
  "name": "eleventy-less-plugin",
  "version": "1.0.0",
  "description": "Eleventy plugin to compile LESS files to CSS with CleanCSS compatibility processing and minification",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akhilgrover-bs/eleventy-less-plugin.git"
  },
  "homepage": "https://github.com/akhilgrover-bs/eleventy-less-plugin#readme",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/"
  ],
  "scripts": {
    "test": "node --input-type=module --eval 'import { eleventyLessPlugin } from \"./index.js\"; console.log(\"ESM OK:\", typeof eleventyLessPlugin);'",
    "test:cjs": "node -e \"const { eleventyLessPlugin } = require('./index.cjs'); console.log('CJS OK:', typeof eleventyLessPlugin);\""
  },
  "keywords": [
    "eleventy",
    "11ty",
    "less",
    "css",
    "plugin",
    "cleancss",
    "minify",
    "autoprefixer",
    "purgecss"
  ],
  "license": "MIT",
  "dependencies": {
    "clean-css": "^5.3.3",
    "fast-glob": "^3.3.2",
    "less": "^4.2.0"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=2.0.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "purgecss": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@11ty/eleventy": {
      "optional": true
    },
    "autoprefixer": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "purgecss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
